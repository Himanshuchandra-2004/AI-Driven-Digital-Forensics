# ============================================================
# AI-Driven Digital Forensics - Environment Variables
# ============================================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# ---------- Database ----------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=forensics_db
POSTGRES_USER=forensics_user
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- JWT ----------
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- Upload ----------
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=uploads

# ---------- ML ----------
MODEL_DIR=../ml/models
DEMO_DATA_RECORDS=5000

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
